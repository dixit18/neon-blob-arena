{
  "name": "playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "npm run build:server && npm --prefix apps/web run build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "tsx --test \"packages/*/test/*.test.ts\" \"apps/server/test/*.test.ts\" \"games/*/test/*.test.ts\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0"
  }
}
